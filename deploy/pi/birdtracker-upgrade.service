[Unit]
Description=Bird Tracker: install operating system security updates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/usr/bin/apt-get update -q
# Security updates only, set by deploy/pi/52birdtracker-unattended-upgrades. Doesn't reboot: the
# update check reports when a reboot is required.
ExecStart=/usr/bin/unattended-upgrade -v
# Refreshes the update report afterward, whether or not the install succeeded.
ExecStopPost=/usr/bin/systemctl start --no-block birdtracker-updates.service
